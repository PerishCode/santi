# window nginx — the read-only audit surface's front.
#
# Serves the static panel at / and BARE-proxies its data reads to santi on
# 127.0.0.1 (santi is auth-free and bound to loopback; NO bearer is injected).
# Public access is normally gated upstream by authentik forward-auth at the
# traefik IngressRoute. The exact downstream data paths bypass authentik and
# carry santi's zone credential; this nginx preserves it without interpreting it.
#
# Read/write split (the glass wall): forward-auth lets both humans (SSO cookie)
# and the machine (a client_credentials JWT in Authorization: Bearer) reach us.
# Reads (GET/HEAD) are open to either; write methods require the Bearer path, so
# a human viewer can SEE but not mutate. Webhook ingest is exempt (external
# callers carry no bearer; santi verifies the per-subscription signature). The
# exact downstream paths are also exempt because santi verifies their Bearer and
# applies zone authorization itself.
#
# Runs as a hostNetwork pod so it can reach santi at 127.0.0.1 and bind the
# node's private cni0 gateway ({bridge_ip} — pod-reachable by traefik, NOT routable
# from the internet) plus loopback. Mounted at /etc/nginx/conf.d/default.conf, so
# the map blocks below sit in the http context (no envsubst — these are nginx
# variables, not env).

# the machine-uid map key below is a 64-char hash → doesn't fit the default bucket
map_hash_bucket_size 128;

map $request_method $is_write_method {{
    default 1;
    GET     0;
    HEAD    0;
    OPTIONS 0;
}}
# Machine (service-account) identity. authentik's outpost sets X-Authentik-Uid and
# traefik copies it onto the request (authResponseHeaders), overwriting any
# client-supplied value — so it is unforgeable. Humans (SSO cookie) get their own
# uid; only the santi-window-cli service account may write. A bearer-presence check
# is NOT enough: an authenticated human can pass forward-auth by cookie and still
# attach a bogus Authorization: Bearer, which nginx would otherwise honour.
# NOTE: update this uid if the santi-window-cli service account is ever recreated.
map $http_x_authentik_uid $is_machine {{
    default                                                            0;
    "{authentik_uid}" 1;
}}

server {{
    listen {bridge_ip}:8088;
    listen 127.0.0.1:8088;
    server_name _;

    # The audit page. A projection surface; never cached stale.
    location = / {{
        root /usr/share/nginx/html;
        try_files /index.html =404;
        add_header Cache-Control "no-store";
    }}

    # Keep the exact management collection explicit. Without this exact
    # location nginx canonicalizes it to /api/v1/webhooks/ because the proxied
    # prefix below ends in a slash, crossing from the authenticated route into
    # the public webhook-ingest route.
    location = /api/v1/webhooks {{
        set $deny "";
        if ($is_write_method) {{ set $deny "W"; }}
        if ($is_machine)      {{ set $deny "${{deny}}M"; }}
        if ($deny = "W")      {{ return 403; }}

        proxy_pass http://127.0.0.1:{santi_port};
        proxy_set_header Host $host;
    }}

    # Webhook event ingest — exempt from the write-split (GitHub/feishu POST
    # with no bearer; santi authenticates them by signature).
    location /api/v1/webhooks/ {{
        proxy_pass http://127.0.0.1:{santi_port};
        proxy_set_header Host $host;
    }}

    location = /api/v1/ingest {{
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:{santi_port};
        proxy_set_header Host $host;
    }}

    location = /api/v1/turn-events {{
        proxy_pass http://127.0.0.1:{santi_port};
        proxy_set_header Host $host;
    }}

    location = /api/v1/turn-events/stream {{
        proxy_pass http://127.0.0.1:{santi_port};
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }}

    # Panel reads + machine ops. Reads open to any forward-auth'd identity;
    # writes require the machine (service-account) identity — humans → cookie →
    # read-only → 403.
    location /api/ {{
        set $deny "";
        if ($is_write_method) {{ set $deny "W"; }}
        if ($is_machine)      {{ set $deny "${{deny}}M"; }}
        if ($deny = "W")      {{ return 403; }}

        proxy_pass http://127.0.0.1:{santi_port};
        proxy_set_header Host $host;
        # SSE: stream through, don't buffer, keep the connection open.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding on;
    }}

    location = /healthz {{ return 200 "ok\n"; add_header Content-Type text/plain; }}
}}
