# santi.env — systemd EnvironmentFile for santi.service.
# Copy to /etc/santi/santi.env, fill in real values, `chmod 600`, own by santi.
# santi.toml stays secret-free (env:// refs resolve against these).

# --- provider secrets (only the selected provider's keys need to resolve) ---
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=

# --- the runtime's API bearer (all endpoints except /health) ---
# SANTI_API_KEY=

# --- webhook signing secrets (subscriptions store only these variable names) ---
# SANTI_WEBHOOK_GITHUB_SECRET=

# Graceful-shutdown drain budget (default 600); santi.service TimeoutStopSec
# must exceed it.
# SANTI_SERVER_GRACE=600
