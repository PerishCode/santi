# santi ops SSH config — SEED. Copy to `.local/ssh/config` (gitignored) and fill:
#   - HostName for each host below
#   - the private key at `.local/ssh/id_santi_ops` (0600), referenced under Host *
#   - `.local/ssh/known_hosts` is populated on first connect (accept-new)
#
# The `:ssh` and `:deploy` wrappers run `ssh -F .local/ssh/config <host>` from the
# repo root, so all paths here are relative to the repo root. Real IPs are a
# secret on a PUBLIC repo — they live only in `.local/`, never in this template.

Host *
  IdentityFile .local/ssh/id_santi_ops
  UserKnownHostsFile .local/ssh/known_hosts
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking accept-new
  ConnectTimeout 10
  ServerAliveInterval 15
  ServerAliveCountMax 4
  ControlMaster auto
  ControlPath .local/ssh/cm-%r@%h-%p
  ControlPersist 60s

# Host root namespace: machine-level ops, package/systemd/k3s break-glass.
Host hk-03.zxiyun
  HostName <FILL: hk-03 ip>
  User root

# Project/user namespace: day-to-day santi repo/runtime work as the service user
# (for example `~/santi-dev`, `gh`, and runtime-owned files) without a sudo hop.
Host santi.hk-03.zxiyun
  HostName <FILL: hk-03 ip>
  User santi
