# Provider selection (see santi.example.toml -> copy to santi.toml)
SANTI_CONFIG=santi.toml
SANTI_PROVIDER=

# Runtime
SANTI_PATHS_DATABASE=.tmp/santi.sqlite
SANTI_LISTEN_HOST=127.0.0.1
SANTI_LISTEN_PORT=43307

# Optional bearer auth. Set on the server to require it; clients send it too.
# SANTI_API_KEY=
